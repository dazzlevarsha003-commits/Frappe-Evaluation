 "html": "\n<h2 style=\"text-align: center;\">Client Work Statement</h2>\n\n<p style=\"text-align: center;\">\n    {{ doc.print_summary or \"\" }}\n</p>\n\n<hr>\n\n{% if doc.status != \"Approved\" and doc.status != \"Invoiced\" %}\n    <p style=\"text-align: center; color: #b00020;\">\n        <strong>PENDING APPROVAL \u2014 NOT YET BILLABLE</strong>\n    </p>\n{% endif %}\n\n<h3>Team Member & Client Details</h3>\n\n<table class=\"details\">\n    <tr>\n        <td><strong>Team Member</strong></td>\n        <td>{{ doc.team_member }}</td>\n        <td><strong>Client</strong></td>\n        <td>{{ doc.client }}</td>\n    </tr>\n    <tr>\n        <td><strong>Work Date</strong></td>\n        <td>{{ doc.work_date }}</td>\n        <td><strong>Status</strong></td>\n        <td>{{ doc.status }}</td>\n    </tr>\n</table>\n\n<p>\n    <strong>Description:</strong>\n    {{ doc.description or \"-\" }}\n</p>\n\n<h3>Time Log Details</h3>\n\n<table class=\"time-logs\n    {% if doc.time_log|length > 10 %}page-break{% endif %}\">\n    <thead>\n        <tr>\n            <th>S.No</th>\n            <th>Activity Type</th>\n            <th>Project</th>\n            <th>Notes</th>\n            <th>Hours</th>\n        </tr>\n    </thead>\n\n    <tbody>\n        {% for row in doc.time_log %}\n        <tr>\n            <td>{{ loop.index }}</td>\n            <td>{{ row.activity_type }}</td>\n            <td>{{ row.project or \"-\" }}</td>\n            <td>{{ row.notes or \"-\" }}</td>\n            <td>{{ frappe.format_value(row.hours, \"Float\") }}</td>\n        </tr>\n        {% endfor %}\n    </tbody>\n\n    <tfoot>\n        <tr>\n            <td colspan=\"4\" style=\"text-align: right;\">\n                <strong>Total Hours</strong>\n            </td>\n            <td>\n                <strong>{{ frappe.format_value(doc.total_hours, \"Float\") }}</strong>\n            </td>\n        </tr>\n    </tfoot>\n</table>\n\n<h2 style=\"text-align: right; margin-top: 25px;\">\n    Total Hours: {{ frappe.format_value(doc.total_hours, \"Float\") }}\n</h2>\n\n<hr>\n\n<p style=\"text-align: center; font-size: 11px;\">\n    Lumen & Loom | Client Work Statement\n</p>\n",
