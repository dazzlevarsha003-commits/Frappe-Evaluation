\\\":\\\"Float\\\"},{\\\"label\\\":\\\"Remaining Hours at Submission\\\",\\\"fieldname\\\":\\\"remaining_hours_at_submission\\\",\\\"fieldtype\\\":\\\"Float\\\"},{\\\"label\\\":\\\"Status \\\",\\\"fieldname\\\":\\\"status\\\",\\\"fieldtype\\\":\\\"Select\\\",\\\"options\\\":\\\"Draft\\\\nPending Approval\\\\nApproved\\\\nRejected\\\\nInvoiced\\\\nCancelled\\\"},{\\\"label\\\":\\\"Approved By\\\",\\\"fieldname\\\":\\\"approved_by\\\",\\\"fieldtype\\\":\\\"Link\\\",\\\"options\\\":\\\"User\\\"}]}],\\\"has_fields\\\":true}],\\\"footer\\\":{\\\"columns\\\":[{\\\"label\\\":\\\"\\\",\\\"fields\\\":[]}]}}\",\n \"margin_bottom\": 15,\n \"margin_left\": 15,\n \"margin_right\": 15,\n \"margin_top\": 15,\n \"page_number\": \"Hide\",\n \"pdf_generator\": \"chrome\",\n \"print_format_builder\": 0,\n \"print_format_builder_beta\": 1,\n \"show_label_colon\": 0\n}",
